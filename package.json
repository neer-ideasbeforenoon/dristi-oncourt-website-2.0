{
  "name": "dristi-oncourt-website-2.0",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for 24x7 ON Court, the courts running on the DRISTI platform. Server-rendered, bilingual, and built on the pinned Pucar design system.",
  "scripts": {
    "postinstall": "node scripts/ensure-ds.mjs",
    "setup:ds": "node scripts/ensure-ds.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run check:tokens && npm run check:portal-tokens && npm run check:typography && npm run check:ui-sync && npm run check:meta && npm run check:i18n",
    "check:ship": "npm run build && npm run check:ssr && npm run check:budget",
    "verify": "npm run check:ds-fresh && npm run check:ds-docs && npm run lint && npm run check:ship",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:portal-tokens": "node scripts/check-portal-tokens.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "check:ui-sync": "node scripts/check-ui-sync.mjs",
    "check:meta": "node scripts/check-meta.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:ds-fresh": "node scripts/check-ds-fresh.mjs",
    "check:ds-docs": "node scripts/check-ds-docs.mjs",
    "sync:ui": "node scripts/sync-ui-from-ds.mjs",
    "sync:ds-docs": "node scripts/sync-ds-docs.mjs",
    "ds:bump": "node scripts/bump-ds.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
